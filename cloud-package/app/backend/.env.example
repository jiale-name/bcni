# ============================================================================
# 2026 顶配版 AI 数字化人才平台 · 后端环境变量模板（一期 · N1 应用基座）
#
# 用法：复制为 backend/.env 后按本机情况修改。
#   cp backend/.env.example backend/.env
#
# 🔴 铁律（架构 §5）：**全部配置经 app/config.py 读取，禁止硬编码**。
#    本文件是唯一的环境变量清单 —— 新增配置项必须同时更新三处：
#    ① 本模板 ② app/config.py 的 Settings ③ 文档（架构 §5 配置表）
#
# 加载顺序（后者被前者覆盖）：进程环境变量 > backend/.env > 仓库根 .env
# ============================================================================

# ---------------------------------------------------------------------------
# 应用
# ---------------------------------------------------------------------------
APP_NAME=AI 数字化人才平台
APP_VERSION=0.1.0
APP_ENV=dev                     # dev | test | prod
APP_HOST=0.0.0.0
APP_PORT=8002                   # 架构 §7.3：后端固定 8002
API_V1_PREFIX=/api/v1
DEBUG=true

# ---------------------------------------------------------------------------
# DS-1 MySQL（一期唯一关系库，28 表）
#   ⚠️ 数据库必须先手工建好（Alembic 只负责建表，不负责建库）：
#      CREATE DATABASE talent_platform_v2 DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#
#   🔴 库名偏离设计文档 DS-1：DS-1 规定 `talent_platform`，但本机该库已被
#      2026-08-30 的旧 schema（11 表，AUTO_INCREMENT 主键、无 tenant_id）连同真实数据占用，
#      其 `sys_user` 与本项目迁移的 `sys_user` 同名不同构，直接建表必冲突。
#      故本项目使用 `talent_platform_v2`，旧库 `talent_platform` 原样保留（非破坏性）。
#      ▶ 若确认旧库可弃，只需把下面 MYSQL_DATABASE 改回 talent_platform 并重建库即可回归 DS-1。
# ---------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=talent_platform_v2
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_CONNECT_TIMEOUT=5

# ---------------------------------------------------------------------------
# 🔴 审计写入专用库账号（CU-08「只追加」的**第三层**保证 / CU-24 落地物）
#   「审计只追加」有三层：① 模型没有 is_deleted/updated_at 列；② DAO 只导出
#   insert/list/count；③ **这个账号在库级没有 UPDATE/DELETE 权限**。
#   ⚠️ ①② 挡的是应用代码，挡不住有人直接连库写 SQL —— 只有 ③ 挡得住。
#   ⚠️ 两个连接串**只有账号不同**（host/port/db 必须一致）：拆的是权限，不是数据位置。
#   ⚠️ **留空 = 退回主账号**：功能完全正常，只是第三层保证不生效。
#      这是有意的 fail-open —— 不该因一个配置缺失让业务停摆。
#   建号：deploy/mysql-init/01-audit-account.sh（首次 up 自动执行，或手工 bash < 该文件）
# ---------------------------------------------------------------------------
AUDIT_DB_USER=
AUDIT_DB_PASSWORD=

# ---------------------------------------------------------------------------
# DS-3 Redis（sess / cache / rate / agent_mem / queue）—— 只存可丢数据
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=
# 🔴 RESP 协议版本，**保持 2**。
#   redis-py 8.x 默认 RESP3，连接时先发 `HELLO 3` 协商；而 `HELLO` 是 Redis 6.0 才有的命令，
#   旧版 / Windows 版 / 部分国产 Redis 会直接报 `unknown command 'HELLO'` ——
#   现象是「Redis 进程活着，应用却连不上」。本项目不需要 RESP3，固定 RESP2 最兼容。
REDIS_PROTOCOL=2

# ---------------------------------------------------------------------------
# DS-2 Milvus（N4/N5 启用，本期留空即可）
# ---------------------------------------------------------------------------
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_DATABASE=talent_vec
MILVUS_TIMEOUT=10

# ---------------------------------------------------------------------------
# DS-4 MinIO（原始简历文件，N2 启用）
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=talent-files
MINIO_SECURE=false

# ---------------------------------------------------------------------------
# 认证与安全（F-1.2）
#   🔴 JWT_SECRET_KEY 必须改！生成方式：
#      python -c "import secrets; print(secrets.token_urlsafe(48))"
#   🔴 AES_KEY 为 64 位 hex（32 字节），用于身份证/手机/邮箱加密：
#      python -c "import secrets; print(secrets.token_hex(32))"
#   🔴 CONTACT_HASH_SALT 用于 phone_hash / id_card_hash 的**不可逆比对哈希**。
#      手机号仅 10^11 个可能值，裸 SHA256 在 GPU 上秒级可穷举 —— 必须加盐。
#      python -c "import secrets; print(secrets.token_hex(16))"
#      ⚠️ 必须与 AES_KEY 取不同的值；且**一经使用不可更换**（换盐会让已入库哈希全部失效）。
#      ⚠️ 留空时 hash_contact() 会直接抛错（fail-loud），不会静默产出弱哈希。
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_IN_ENV_FILE__dev_only_placeholder_secret__do_not_use_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=7200
REFRESH_TOKEN_EXPIRE_SECONDS=604800
BCRYPT_ROUNDS=12
LOGIN_MAX_FAIL_COUNT=5
LOGIN_LOCK_SECONDS=600
AES_KEY=
CONTACT_HASH_SALT=

# ---------------------------------------------------------------------------
# 雪花 ID（数据库 §0.1：应用生成，有符号 BIGINT）
#   ⚠️ 多实例部署时 **每个实例的 WORKER_ID 必须不同**，否则会撞号。
# ---------------------------------------------------------------------------
SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_DATACENTER_ID=1
SNOWFLAKE_EPOCH_MS=1704038400000

# ---------------------------------------------------------------------------
# 限流（F-1.6）与 CORS
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# 上传上限（接口 §1.5 → 41301）
# ---------------------------------------------------------------------------
UPLOAD_MAX_FILES_PER_BATCH=100
UPLOAD_MAX_FILE_SIZE_MB=50
# 原始简历文件本地留存目录（MinIO 就绪前落盘于此；MinIO 接入后仅作降级兜底）
UPLOAD_STORAGE_DIR=data/uploads
# 复核工作量估算的平均单条耗时（秒，API-44/49 口径）
REVIEW_AVG_SECONDS_PER_ITEM=20

# ---------------------------------------------------------------------------
# 个人权利响应（CU-22，F-3.11 / SM-3）
# ---------------------------------------------------------------------------
# 权利请求（更正/删除/导出）的处理时限（小时）。提交时快照进请求单，
# 改本值不影响历史单据的「是否超时」判定（合规数字必须可复核）。
PRIVACY_SLA_HOURS=72

# ---------------------------------------------------------------------------
# AI 算力（D-4 混合算力路由；N2/N5 启用）
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_PARSE=qwen2.5:3b
OLLAMA_MODEL_REASON=qwen3:8b
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL=bge-reranker-v2-m3
RERANKER_BASE_URL=http://127.0.0.1:9997
DIFY_BASE_URL=http://127.0.0.1
DIFY_API_KEY=

# ---------------------------------------------------------------------------
# 模型网关 / 成本 / Agent（F-9.1 · F-9.5 · F-A0 —— CU-10 ~ CU-13）
# ---------------------------------------------------------------------------
# 🔴 网关兜底超时（秒）。单个模型可在 ai_model_config.timeout_seconds 里覆盖。
#    ⚠️ 网关内部会**夹紧**该值：过大（上游卡死时占住线程池）与过小（必然超时）
#       都会让「主备切换」形同虚设，故小于下界即抬到下界。
AI_GATEWAY_DEFAULT_TIMEOUT=60
# 🔴 成本看板（API-88）的**标记**阈值（元）：超出时 summary 带 cost_alert=true。
#    ⚠️ 接口 §3 明确「**本接口只呈报不告警**」—— 真正的告警动作属运维侧，不在此做。
AI_COST_ALERT_YUAN=100
# 🔴 脱敏率（mask_applied_rate）下限，**默认 1.0 不要调低**：
#    分母是 deployment='cloud' 的调用数（调用时刻的事实，不由模型配置当前值推导），
#    **低于 1.0 即意味着存在未脱敏出网的调用** —— 这是合规红线，不是性能指标。
#    低于该值时 API-88 置 mask_alert=true。
AI_MASK_APPLIED_RATE_FLOOR=1.0
# 🔴 Agent 图单次运行最大步数（死循环兜底）。图定义里显式给了 max_steps 时以图为准。
AGENT_MAX_STEPS=50
# agent_step 的保留月数（数据库 §9）。⚠️ 仅用于**清理提示**，
# 实际清理是运维动作，不由应用自动执行（自动删执行轨迹不可逆，必须有人按按钮）。
AGENT_STEP_RETENTION_MONTHS=6

# 🔴 出网通道（ADR-4 / D-15）：仅接收「脱敏占位符片段 + Prompt」，留空即禁用出网
CLOUD_LLM_BASE_URL=
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=

# ---------------------------------------------------------------------------
# RAG 参数基线（需求 §10.2 / D-14）—— 全部可配，禁止散落魔法数
# ---------------------------------------------------------------------------
RAG_RECALL_TOP_K=20
RAG_RRF_K=60
RAG_RERANK_TOP_N=5
RAG_NO_ANSWER_THRESHOLD=0.35
RAG_RETRIEVAL_MODE=hybrid

# ---------------------------------------------------------------------------
# 确定性阈值（需求 §10.1 约束³）
# ---------------------------------------------------------------------------
PARSE_CONFIDENCE_THRESHOLD=0.85
PARSE_LOW_IMPACT_SAMPLE_RATE=0.10
DEDUP_SIMILARITY_THRESHOLD=0.90
