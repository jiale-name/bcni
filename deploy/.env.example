# ============================================================================
# deploy/.env.example —— 部署期变量模板（CU-24）
#
# 用法：
#   cp deploy/.env.example deploy/.env        # 然后逐项填真实值
#   docker compose -f deploy/docker-compose.dev.yml --env-file deploy/.env up -d
#
# 🔴 **本文件入库、``deploy/.env`` 不入库**（架构 §7.4「配置外置」）。
# 密钥只经环境变量注入，**不落库、不入镜像**（NFR-15）。
# ============================================================================

# ---------------------------------------------------------------------------
# ① 数据组件的主账号与密钥（首次 ``up`` 时由 MySQL / Redis / MinIO 镜像读取）
# ---------------------------------------------------------------------------
# ⚠️ MySQL 的 root 密码**必须与 backend/.env 的 MYSQL_PASSWORD 一致**，
#    否则容器里的库和后端连的库是两个世界。
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=talent_platform_v2

REDIS_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MILVUS_BUCKET=milvus-bucket

# ---------------------------------------------------------------------------
# ② 🔴 审计专用库账号（「只追加」的**第三层**保证，见 backend/app/config.py）
# ---------------------------------------------------------------------------
# 这个账号在库级只有 ``SELECT`` + ``INSERT``：改/删审计记录在**数据库层面**就不可能，
# 不再依赖「应用代码不去改」这条约定（前两层挡应用代码，挡不住直接连库写 SQL）。
#
# 三个值必须一致：
#   deploy/.env              AUDIT_DB_USER / AUDIT_DB_PASSWORD   ← 建号用
#   backend/.env             AUDIT_DB_USER / AUDIT_DB_PASSWORD   ← 连接用
# ``AUDIT_DB_USER`` 留空时后端**退回主账号**（功能正常，只是这一层保证不生效）。
AUDIT_DB_USER=audit_writer
AUDIT_DB_PASSWORD=

# ---------------------------------------------------------------------------
# ③ 宿主端口映射（架构 §7.3 的「宿主端口」列）
# ---------------------------------------------------------------------------
# 🔴 **本机已装 MySQL / Redis 时保留默认值会「端口已被占用」**。
#    两种处置：① 不跑 compose 的对应服务（用宿主服务，改 backend/.env 即可）；
#              ② 把下面两项改成 13306 / 16379，**并同步改 backend/.env**（必须成对改）。
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MILVUS_PORT=19530
MILVUS_HTTP_PORT=9091

# ---------------------------------------------------------------------------
# ④ 后端 / 前端（**不由本 compose 管理**，仅登记约定值，便于对照排查）
# ---------------------------------------------------------------------------
# 后端 :8002（架构 §7.3，用户手动管理进程，**不带 --reload**）、
# 前端 dev :5173（Vite proxy /api → :8002）、前端 prod :80（Nginx）。
# 复用宿主机服务：Ollama :11434、Dify :80/5001、Reranker :9997。
# 容器内访问宿主服务用 ``host.docker.internal``。
